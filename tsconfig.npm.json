{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "lib": ["ES2023", "DOM", "WebWorker", "ES2024.SharedMemory"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "types": ["bun-types", "node"]
  },
  "include": [
    "knitting.ts",
    "knitting.browser.ts",
    "process-shared-buffer.ts",
    "shared-memory.ts",
    "unsafe.ts",
    "utils.ts",
    "src/**/*.ts"
  ]
}
