{
  "name": "knitting",
  "version": "0.1.70",
  "description": "Shared-memory IPC runtime for Node.js, Deno, and Bun.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimiMonads/knitting.git"
  },
  "bugs": {
    "url": "https://github.com/mimiMonads/knitting/issues"
  },
  "homepage": "https://github.com/mimiMonads/knitting#readme",
  "type": "module",
  "main": "./knitting.js",
  "module": "./knitting.js",
  "types": "./knitting.d.ts",
  "exports": {
    ".": {
      "types": "./knitting.d.ts",
      "default": "./knitting.js"
    },
    "./browser": {
      "types": "./knitting.browser.d.ts",
      "default": "./knitting.browser.js"
    },
    "./process-shared-buffer": {
      "types": "./process-shared-buffer.d.ts",
      "default": "./process-shared-buffer.js"
    },
    "./shared-memory": {
      "types": "./shared-memory.d.ts",
      "default": "./shared-memory.js"
    },
    "./unsafe": {
      "types": "./unsafe.d.ts",
      "default": "./unsafe.js"
    },
    "./utils": {
      "types": "./utils.d.ts",
      "default": "./utils.js"
    }
  },
  "files": [
    "README.md",
    "BROWSER.md",
    "map.md",
    "LICENSE",
    "prebuilds/**/*.node",
    "prebuilds/**/*.dll",
    "scripts/build-native-addons.ts",
    "scripts/build-compiled-worker.ts",
    "scripts/compiled-worker/**/*.ts",
    "scripts/compiled-worker/**/*.d.ts",
    "src/**/*.cc",
    "src/**/*.d.ts",
    "src/**/*.js",
    "knitting.browser.d.ts",
    "knitting.browser.js",
    "knitting.d.ts",
    "knitting.js",
    "process-shared-buffer.d.ts",
    "process-shared-buffer.js",
    "shared-memory.d.ts",
    "shared-memory.js",
    "unsafe.d.ts",
    "unsafe.js",
    "utils.d.ts",
    "utils.js"
  ],
  "scripts": {
    "clean": "bun run scripts/clean-generated.ts",
    "build": "bun run build.ts && node scripts/rewrite-declaration-imports.mjs",
    "build:js": "bun run build.ts && node scripts/rewrite-declaration-imports.mjs",
    "build:types": "bun run build.ts && node scripts/rewrite-declaration-imports.mjs",
    "build:npm": "bun run build.ts && node scripts/rewrite-declaration-imports.mjs",
    "build:native": "bun run scripts/build-native-addons.ts",
    "build:compiled": "bun run scripts/build-compiled-worker.ts",
    "build:browser": "bun run scripts/build-browser.ts",
    "build:release": "bun run build:native && npm run build",
    "build:node": "bun run build.ts && node scripts/rewrite-declaration-imports.mjs",
    "prepack": "npm run build",
    "release:npm": "npm run test:all && npm publish",
    "release:npm:dry-run": "npm publish --dry-run",
    "test": "npm run test:deno",
    "test:deno": "deno test -A --ignore=test/runtime.node.test.ts --ignore=test/runtime.process.test.ts",
    "test:node": "node --no-warnings --experimental-transform-types --test \"./test/*.test.ts\"",
    "test:node:26": "node --no-warnings --experimental-ffi test/node26-ffi.integration.mjs",
    "test:bun": "bun test",
    "test:browser": "bun run scripts/test-browser.ts",
    "check:windows-park": "bun run scripts/check-windows-park.ts",
    "test:runtimes": "npm run test:node && npm run test:bun",
    "test:all": "npm run test:deno && npm run test:runtimes && npm run test:browser",
    "coverage:node": "node --no-warnings --experimental-transform-types --experimental-test-coverage --test \"./test/*.test.ts\"",
    "coverage:node:90": "node --no-warnings --experimental-transform-types --experimental-test-coverage --test-coverage-lines=90 --test-coverage-exclude=src/common/task-source.ts --test-coverage-exclude=src/ipc/protocol/parsers/NumericBuffer.ts --test-coverage-exclude=src/runtime/balancer.ts --test-coverage-exclude=src/worker/task-loader.ts --test \"./test/*.test.ts\"",
    "bench": "./run.sh",
    "bench:json": "./run.sh --json"
  },
  "engines": {
    "node": ">=22.0.0",
    "deno": ">=2.0.0",
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/deno": "latest",
    "@types/node": "latest",
    "mitata": "^1.0.34",
    "typescript": "^5.2.0"
  }
}
